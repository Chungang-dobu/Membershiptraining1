rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 이메일 목록: Firebase Authentication 에 등록한 관리자 이메일(소문자)로 바꿔 주세요.
    // 여러 명이면 ['a@gmail.com', 'b@gmail.com'] 처럼 적습니다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['YOUR_ADMIN_EMAIL@gmail.com'];
    }

    function isValidResponse(d) {
      return d.keys().hasOnly(['name', 'phone', 'attendance', 'conflictDates', 'conflictNote', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.phone is string && d.phone.matches('^01[016789]-[0-9]{3,4}-[0-9]{4}$')
        && d.attendance in ['yes', 'no']
        // 변경할 수 없는 일정(불가 날짜 목록, 메모)은 참석하는 사람만 적을 수 있습니다.
        && d.conflictDates is list && d.conflictDates.size() <= 60
        && d.conflictNote is string && d.conflictNote.size() <= 300
        && (d.attendance == 'yes' || (d.conflictDates.size() == 0 && d.conflictNote.size() == 0))
        && d.createdAt == request.time;
    }

    match /responses/{id} {
      // 누구나 응답을 제출할 수 있지만, 조회·삭제는 관리자만 가능합니다.
      allow create: if isValidResponse(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
